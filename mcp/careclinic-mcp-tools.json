      {
        "name": "careclinic_preview_log",
        "title": "Preview a CareClinic check-in",
        "description": "Validates an exact owned symptom, mood or sleep entry and creates a short-lived confirmation preview. It never writes data. Scheduled medication and supplement taken/skipped events are enabled.",
        "inputSchema": {
          "type": "object",
          "$schema": "https://json-schema.org/draft/2020-12/schema",
          "properties": {
            "entry": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "domain": {
                      "type": "string",
                      "const": "symptom"
                    },
                    "symptomId": {
                      "type": "string",
                      "minLength": 32,
                      "maxLength": 1024,
                      "pattern": "^cc1\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$"
                    },
                    "name": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "severity": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 10
                    },
                    "occurredAt": {
                      "type": "string",
                      "format": "date-time",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d(?::[0-5]\\d(?:\\.\\d+)?)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
                    },
                    "durationMinutes": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 43200
                    },
                    "note": {
                      "type": "string",
                      "maxLength": 300
                    }
                  },
                  "required": [
                    "domain",
                    "symptomId",
                    "name",
                    "severity",
                    "occurredAt"
                  ]
                },
                {
                  "type": "object",
                  "properties": {
                    "domain": {
                      "type": "string",
                      "const": "mood"
                    },
                    "label": {
                      "type": "string",
                      "maxLength": 120
                    },
                    "valence": {
                      "type": "integer",
                      "minimum": -5,
                      "maximum": 5
                    },
                    "energy": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 10
